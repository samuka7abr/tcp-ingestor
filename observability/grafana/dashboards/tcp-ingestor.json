      "options": { "legend": { "calcs": ["max"], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(tcp_ingestor_chunks_received_total[$__rate_interval])", "legendFormat": "recebidos/s", "refId": "A" },
        { "expr": "rate(tcp_ingestor_chunks_persisted_total[$__rate_interval])", "legendFormat": "persistidos/s", "refId": "B" }
