TCP_ADDR=0.0.0.0:7000
METRICS_ADDR=0.0.0.0:9898
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tcp_ingestor
MONGODB_COLLECTION=traffic
QUEUE_CAPACITY=10000
BATCH_SIZE=500
BATCH_FLUSH_MS=500
READ_BUFFER_BYTES=8192
RUST_LOG=info

# Docker Compose only. Keep mongo:8.0 unless your environment requires another tag.
MONGODB_IMAGE=mongo:8.0
